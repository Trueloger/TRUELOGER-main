rules_version = '2';

// Production Firestore Security Rules for TRUELOGER.
//
// Design:
// - `users/{uid}` is the profile doc. The owner may read/update it
//   directly via the client SDK, but NEVER through this rule set can
//   they write `admin`-flavoured fields into it — admin status lives
//   exclusively in the Firebase Auth custom claim (`request.auth.token.admin`),
//   never in a Firestore document a user could otherwise edit.
// - `orders/{orderId}` is written EXCLUSIVELY by server code using the
//   Admin SDK (create-order/verify/webhook routes), which bypasses
//   these rules entirely. Client-side writes are therefore denied
//   outright — there is no legitimate path for a browser to create or
//   modify an order document directly. Reads are limited to the
//   order's own owner or an admin.
// - `adminAuditLog/{entryId}` is admin-read-only, server-write-only —
//   same reasoning as orders.
// - No collection here uses `allow read, write: if true` anywhere.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // The ONLY admin check this rule set trusts — a Firebase Auth
    // custom claim, set exclusively by scripts/dev/set-admin-claim.ts
    // running with Admin SDK privileges. Never based on email.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // A user may create/update their OWN profile document, but never
      // introduce or change a field that would look like a role/claim
      // — `admin` is never a legal field on this document at all.
      allow create, update: if isOwner(uid) && !("admin" in request.resource.data);
      allow delete: if false; // account deletion goes through a controlled server flow, not a raw doc delete
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // No direct client writes at all — every order write goes
      // through the Admin SDK (create-order / verify / webhook routes
      // and the admin fulfillment-update route), which is a superuser
      // context these rules don't apply to. A client attempting to
      // write here directly is therefore always denied.
      allow write: if false;
    }

    match /adminAuditLog/{entryId} {
      allow read: if isAdmin();
      allow write: if false; // server (Admin SDK) only
    }

    // Products — every storefront read (listing + detail) goes through
    // /api/products and /api/products/[slug], which use the Admin SDK
    // and already filter to status=="published" server-side; a
    // signed-in customer may ALSO read a published product directly
    // via the client SDK if some future UI piece wants a live listener,
    // but never a draft/archived one, and never write at all (every
    // write goes through /api/admin/products with the Admin SDK).
    match /products/{productId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow write: if false;
    }

    // Coupons — no client read/write at all. Every legitimate touch
    // (admin CRUD, the customer-facing "eligible coupons" list, cart
    // preview, checkout) goes through a server API using the Admin
    // SDK, which bypasses these rules — there's no reason a browser
    // needs direct Firestore access to full coupon documents (which
    // would otherwise leak restriction/limit internals a customer
    // shouldn't see) when every real use case already has a route.
    match /coupons/{code} {
      allow read, write: if false;
      match /redemptions/{uid} {
        allow read, write: if false;
      }
    }

    // Tax/delivery settings — admin-configured, server-computed into
    // every price a customer sees; no reason for direct client access
    // either direction.
    match /settings/{settingId} {
      allow read, write: if false;
    }

    // Report products — public pricing/delivery-time read for the
    // storefront (same "server API is normally how this is read, but a
    // live listener could reasonably want direct access" reasoning as
    // `products` above). Write only ever goes through
    // /api/admin/reports/products/[slug] using the Admin SDK.
    match /reportProducts/{slug} {
      allow read: if true;
      allow write: if false;
    }

    // Demo reports — fictional/sample data only (never a real user's
    // chart, see scripts/dev/generate-demo-reports.ts), publicly
    // readable so the "View Demo Report" pages need no login. Write
    // only ever via the Admin SDK (the generation script / a future
    // admin-triggered regenerate action, AGENTS §118).
    match /demoReports/{type} {
      allow read: if true;
      allow write: if false;
    }

    // Reports — a user's generated report is highly personal (real
    // birth details, a full AI-written chart interpretation) and must
    // NEVER be readable by anyone but its owner or an admin (AGENTS
    // §35/§76/§77). Owner-or-admin read (enables the account Reports
    // page's live status listener, per AGENTS §105, without needing to
    // poll the API); no client write at all — every write goes through
    // the Admin SDK (order-paid hook, the internal/cron processing
    // routes), a superuser context these rules don't apply to.
    match /reports/{reportId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Default deny for anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
